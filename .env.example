# ─────────────────────────────────────────────────────────────
# API
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# ─────────────────────────────────────────────────────────────
# AI Provider — "azure" | "bedrock" | "mock"
# Use "mock" para rodar sem nenhuma credencial (responde offline).
# ─────────────────────────────────────────────────────────────
AI_PROVIDER=mock

# Azure OpenAI (necessário apenas quando AI_PROVIDER=azure)
AZURE_OPENAI_ENDPOINT=https://<seu-recurso>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# AWS Bedrock (necessário apenas quando AI_PROVIDER=bedrock)
# Credenciais vêm da cadeia padrão do SDK: as vars abaixo, IAM role ou ~/.aws
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ─────────────────────────────────────────────────────────────
# Autenticação JWT
# ─────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRES_IN=1d

# ─────────────────────────────────────────────────────────────
# Bancos de dados
# ─────────────────────────────────────────────────────────────
# Postgres (relacional) — conversas/usuários via Prisma
DATABASE_URL=postgresql://chatbot:chatbot@localhost:5432/chatbot?schema=public

# MongoDB (NoSQL) — histórico de mensagens / telemetria
MONGO_URL=mongodb://localhost:27017/chatbot

# Redis — cache e rate limiting
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────
# Web (Vite)
# ─────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
